generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  onboardedAt  DateTime?

  properties Property[]
  mainBills  MainBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id      String  @id @default(cuid())
  name    String
  address String?

  meters Meter[] @relation("PropertyMeters")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meter {
  id             String  @id @default(cuid())
  name           String
  whatsappNumber String?

  propertyId String
  property   Property @relation("PropertyMeters", fields: [propertyId], references: [id], onDelete: Cascade)

  readings MonthlyReading[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlyReading {
  id String @id @default(cuid())

  month Int
  year  Int

  previousReading Decimal
  currentReading  Decimal

  unitsConsumed Decimal
  ratePerUnit   Decimal
  billAmount    Decimal

  meterId String
  meter   Meter  @relation(fields: [meterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meterId, month, year])
}

model MainBill {
  id     String  @id @default(cuid())
  month  Int
  year   Int
  amount Decimal

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
}
